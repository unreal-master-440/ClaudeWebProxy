# --- server ---
HOST=127.0.0.1
PORT=9656
LOG_LEVEL=info

# --- auth file (создаётся: node scripts/claude_auth.js; в режиме браузера не нужен) ---
AUTH_FILE=claude-auth.json

# --- CDP (управление браузером) ---
CDP_PORT=9222
# пусто = найти автоматически; можно указать имя: chrome, edge, brave
BROWSER=
# полный путь к браузеру, если автоопределение не сработало
CHROME_PATH=
AUTH_TIMEOUT_MS=300000

# --- транспорт к claude.ai ---
CLAUDE_BASE_URL=https://claude.ai
REQUEST_TIMEOUT_MS=180000
SESSION_TTL_MS=1800000
# 1 = запросы выполняются внутри вкладки браузера (нужно из-за Cloudflare)
# 0 = напрямую из Node (быстрее, но Cloudflare обычно отвечает 403 "Just a moment…")
USE_BROWSER_TRANSPORT=1

# --- прокси (если VPN работает как System Proxy: Hiddify / Clash / v2ray) ---
# Пример: HTTPS_PROXY=http://127.0.0.1:12334
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost

# --- режим терминального агента ---
# 1 = прокси выполняет команды, которые модель просит строкой CALL: <команда>,
#     и возвращает ей вывод. Нужен потому, что веб-эндпоинт claude.ai не отдаёт
#     блоки tool_use и Claude Code не может исполнять Bash/Write через прокси.
# ВНИМАНИЕ: режим полный — любая команда на этом компьютере без подтверждения.
AGENT_MODE=0
# рабочая папка, от которой считаются относительные пути в командах
AGENT_CWD=
# максимум раундов «команда → вывод» на одну задачу
AGENT_MAX_STEPS=12
# таймаут одной команды, мс
AGENT_CMD_TIMEOUT_MS=120000
