# Windows-скрипты должны оставаться CRLF, иначе cmd ломается
*.cmd text eol=crlf
# start.cmd хранится в CP866: git НЕ должен менять его байты
start.cmd -text
*.bat text eol=crlf
*.ps1 text eol=crlf

*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf

# Бинарные файлы
*.png binary
*.jpg binary
*.ico binary
